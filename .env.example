# API Configuration
VITE_API_BASE_URL=https://api.example.com

# Development Settings
VITE_ENABLE_MSW=true
VITE_LOG_LEVEL=info

# MSW Configuration
# Enable MSW for API mocking in development
# Set to 'false' to disable mocking and use real APIs
VITE_ENABLE_MSW=true

# Log level: 'silent', 'info', 'debug'
# Controls console logging verbosity
VITE_LOG_LEVEL=info

# Optional: Authentication
VITE_AUTH_ENDPOINT=https://auth.example.com
VITE_CLIENT_ID=your-client-id