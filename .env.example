# API Configuration
# Base URL for the user service API (backend)
# Example: http://localhost:8080 for local development
# Example: https://api.gripday.com for production
VITE_API_URL_SERVER=http://localhost:8080

# Auth Domain Configuration
# The auth domain is where the auth app is hosted
VITE_AUTH_DOMAIN_AUTH=https://auth.iqkv.com
# The app domain is where the main app is hosted
VITE_AUTH_DOMAIN_APP=https://app.iqkv.com

# Auth Redirect Configuration (optional)
# Override default redirect URLs after login/logout/signup
# VITE_AUTH_REDIRECT_AFTER_LOGIN=https://app.iqkv.com
# VITE_AUTH_REDIRECT_AFTER_LOGOUT=https://auth.iqkv.com/login
# VITE_AUTH_REDIRECT_AFTER_SIGNUP=https://auth.iqkv.com/login

# MSW Configuration
# Enable MSW for API mocking in development
# Set to 'false' to disable mocking and use real APIs
VITE_ENABLE_MSW=true

# Log level: 'silent', 'info', 'debug'
# Controls console logging verbosity
VITE_LOG_LEVEL=info