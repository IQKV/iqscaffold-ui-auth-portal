# API Configuration
# Base URL for the user service API (backend)
# Example: http://localhost:8080/api for local development
# Example: https://api.iqscaffold.com/api for production
VITE_API_SERVER_URL=http://localhost:8080/api

# Auth Domain Configuration
# The auth domain is where the auth app is hosted
VITE_AUTH_DOMAIN_AUTH=https://auth.iqscaffold.com
# The app domain is where the main app is hosted
VITE_AUTH_DOMAIN_APP=https://app.iqscaffold.com

# Auth Redirect Configuration (optional)
# Override default redirect URLs after login/logout/signup
# VITE_AUTH_REDIRECT_AFTER_LOGIN=https://app.iqscaffold.com
# VITE_AUTH_REDIRECT_AFTER_LOGOUT=https://auth.iqscaffold.com/login
# VITE_AUTH_REDIRECT_AFTER_SIGNUP=https://auth.iqscaffold.com/login

# MSW Configuration
# Enable MSW for API mocking in development
# Set to 'false' to disable mocking and use real APIs
VITE_ENABLE_MSW=true

# Log level: 'silent', 'info', 'debug'
# Controls console logging verbosity
VITE_LOG_LEVEL=info
